# =====================================================================
# XAUUSD SMC CLOUD ALERT SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your values.
# NEVER commit the real .env file with private credentials to Git!
# =====================================================================

# --- Telegram Bot Credentials (Required for Live Alerts) ---
# 1. Open Telegram and search for @BotFather. Send /newbot to create a bot and get the TOKEN.
# 2. Search for @userinfobot or @GetMyChatIDBot to find your numerical CHAT_ID.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIjkLmNoPqRsTuVwXyZ_example
TELEGRAM_CHAT_ID=123456789

# --- Execution Mode ---
# Set to 'true' to run locally without broadcasting alerts to Telegram.
DRY_RUN=false

# --- Market Data Provider ---
# Options: 'yahoo' (Free, No API Key needed) or 'twelvedata' (Free key, 800 credits/day)
DATA_PROVIDER=yahoo

# Yahoo Finance Symbol Settings:
# 'XAUUSD=X' is Gold Spot Currency feed (closest to broker CFD).
# 'GC=F' is COMEX Gold Futures used as automatic fallback if spot is unavailable.
YAHOO_SYMBOL=XAUUSD=X
YAHOO_FALLBACK_SYMBOL=GC=F

# Twelve Data Symbol & Key (Only needed if DATA_PROVIDER=twelvedata)
TWELVEDATA_SYMBOL=XAU/USD
TWELVEDATA_API_KEY=

# --- Instrument & Timeframe ---
INSTRUMENT=XAUUSD
TIMEFRAME=5m

# --- Smart Money Concepts (SMC) Engine Parameters ---
# Swing pivot lookback length (bars on each side): default 3
SWING_LENGTH=3

# Market Structure Shift (MSS) Displacement Multiplier (e.g. 1.0x ATR)
MIN_DISPLACEMENT_ATR_MULT=1.0
ATR_PERIOD=14

# Confirmation Mode: 'close' (candle close past level) or 'wick'
CONFIRMATION_MODE=close

# --- Session Filtering ---
# Set to 'true' to restrict alerts ONLY to London (08:00 - 16:30 UTC) and New York (13:00 - 21:30 UTC).
# Set to 'false' to monitor whenever gold markets are open.
FILTER_SESSIONS=false

# Timezone for alert timestamps (Default: Asia/Kolkata for IST)
ALERT_TIMEZONE=Asia/Kolkata

# State file location for cross-run deduplication
STATE_FILE_PATH=state.json
